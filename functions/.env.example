# 🎭 The Living Muse - Backend Secrets (Cloud Functions)
# ----------------------------------------------------

# 💳 Stripe Secrets
# Required for verifying transactions and processing upgrades
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 🧠 Vertex AI Model Configuration (Optional Overrides)
# Defaults are set in src/config/env.ts, use these to override
# GEMINI_MODEL=gemini-3.1-pro
# IMAGEN_MODEL=imagen-3-fast
# VEO_MODEL=veo-3-fast
# LYRIA_MODEL=lyria-2

# 🌍 Infrastructure
VERTEX_AI_LOCATION=us-central1
STORAGE_BUCKET=the-living-muse.firebasestorage.app

# 📊 Monetization Parameters
FREE_MONTHLY_LIMIT=3
PRO_MONTHLY_LIMIT=15
